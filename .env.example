# Port for Express server
PORT=5000

# MongoDB connection string (e.g., MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/group_ride_tracker?retryWrites=true&w=majority

# Client URL for CORS during development
CLIENT_URL=http://localhost:5173

# Environment (development / production)
NODE_ENV=development
